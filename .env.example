# MongoDB
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/cloudshareapi

# JWT
JWT_SECRET_KEY=

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend
APP_FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=

# Self-hosted Ollama (see docker-compose.yml) for the DOCX translate feature.
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
# Match to the deployment's logical CPU core count.
OLLAMA_NUM_THREAD=8
# Context window per call; must fit the prompt plus the full translated JSON output.
OLLAMA_NUM_CTX=8192

# Headless LibreOffice binary for Word/PPTX/Excel/HTML <-> PDF conversion. Defaults to
# "soffice" resolved from PATH (true in the Docker image - leave unset there). For native/IDE
# runs on Windows, install LibreOffice and point this at the full soffice.exe path, e.g.:
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
LIBREOFFICE_PATH=

# Server
PORT=8080
