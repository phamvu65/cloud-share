# MongoDB
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/cloudshareapi

# JWT
JWT_SECRET_KEY=

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend
APP_FRONTEND_URL=http://localhost:3000

