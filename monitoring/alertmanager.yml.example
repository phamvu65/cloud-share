global:
    resolve_timeout: 5m

route:
    receiver: telegram
    group_by: ["alertname"]
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 3h

receivers:
    - name: telegram
      telegram_configs:
        - bot_token: "YOUR_TELEGRAM_BOT_TOKEN"
          chat_id: YOUR_TELEGRAM_CHAT_ID
          parse_mode: "HTML"